# Lolly CA service — every environment variable, commented out. Copy to .env
# and run `node --env-file=.env services/ca/server.mjs` (the service loads
# nothing itself — zero dependencies).

# ── core ─────────────────────────────────────────────────────────────────────
# PKCS#8 PEM of the root private key. THE only secret that matters — never
# commit it. Generate both PEMs with: node services/ca/scripts/gen-root.mjs
#CA_ROOT_KEY_PEM="-----BEGIN PRIVATE KEY-----
#...
#-----END PRIVATE KEY-----"

# PEM of the root certificate (public — also committed to shells/web/src/ca-root.js
# and served at GET /api/ca/root.pem).
#CA_ROOT_CERT_PEM="-----BEGIN CERTIFICATE-----
#...
#-----END CERTIFICATE-----"

# Random 32+ bytes (e.g. `openssl rand -hex 32`) — HMAC key for the OAuth
# state cookie and the 10-minute enrollment tokens.
#CA_SERVICE_SECRET=

# Comma list of origins allowed to receive enrollment tokens (postMessage
# target / magic-link base). e.g. https://lolly.tools,http://localhost:5173
#CA_ALLOWED_ORIGINS=https://lolly.tools

# ── issuance policy (optional) ───────────────────────────────────────────────
# Default leaf lifetime in days when the client asks for nothing / something
# outside {7, 30, 90, 365}. Default: 7.
#CA_CERT_DAYS=30
# Hard cap on any issued lifetime. Default: 365.
#CA_CERT_MAX_DAYS=365
# (There is deliberately no issuance-log or log-webhook setting. The CA retains
# nothing about who enrolled — see the comment above `enroll()` in lib/enroll.mjs
# for the reasoning and the tradeoff.)

# ── OIDC providers (set the pairs you actually registered) ───────────────────
# GitHub OAuth app (scope: user:email).
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=

# Google OAuth client, type Web (scopes: openid email).
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# id.suse.com (Okta) OIDC web app (scopes: openid email profile).
#SUSE_ISSUER=https://id.suse.com
#SUSE_CLIENT_ID=
#SUSE_CLIENT_SECRET=

# ── email magic links (Resend) ───────────────────────────────────────────────
#RESEND_API_KEY=
#EMAIL_FROM=Lolly <credentials@lolly.tools>

# ── local dev only — NEVER in production ─────────────────────────────────────
# '1' enables the instant 'dev' provider (dev@example.com, no OAuth) and
# allows any http://localhost:* origin.
#CA_DEV_FAKE_PROVIDER=1

# Port for `node services/ca/server.mjs` (default 8787 — what the Vite dev
# proxy expects).
#PORT=8787
